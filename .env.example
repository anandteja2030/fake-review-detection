# ─────────────────────────────────────────────────────────────────────────────
# Express API (server/) — copy to your process environment; never commit secrets.
# None of these values are secrets; the app stores no credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Adapter mode: 'python-http' (real predictions via the FastAPI service)
# or 'none' (honest model_not_connected responses, no fake output).
ML_ADAPTER_MODE=python-http

# Where the Express API reaches the FastAPI inference service.
# In production this MUST be a reachable URL — NOT localhost unless both
# processes share a host. Examples:
#   same host:        http://127.0.0.1:8501/predict
#   container/VM:     http://ml-service.internal:8501/predict
ML_SERVICE_URL=http://127.0.0.1:8501/predict

# Express listen port (default 4000).
PORT=4000

# Max reviews per /api/analyze/batch request (1-20). The frontend auto-chunks
# larger collections to this size with bounded concurrency.
BATCH_MAX_REVIEWS=10

# Comma-separated CORS allowlist for the API. Empty = allow all origins
# (fine for a public read-mostly demo). Set it to your frontend origin(s) hardening.
# ALLOWED_ORIGINS=https://reviews.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (frontend/, Vite) — build-time variables only.
# ─────────────────────────────────────────────────────────────────────────────
# API base used by the browser. Default '/api' (same-origin: Vite dev proxy,
# or Express serving the built SPA). Set an absolute URL only when the
# frontend is hosted on a DIFFERENT origin than the API:
#   VITE_API_BASE=https://api.reviews.example.com/api
# VITE_API_BASE=/api
